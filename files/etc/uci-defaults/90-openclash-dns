#!/bin/sh
# OpenClash DNS 预置（首次开机执行）：
#   - enable_custom_dns=1：让 uci 里配置的 dns_servers 能生效（覆盖订阅自带 dns 段）。
#   - 不预置 dns_servers：保持 OpenClash 默认「本地 DNS 劫持 = Dnsmasq 转发」模式——
#     dnsmasq 先应答 .lan/租约、只把外部域名转发给内核，天然保住局域网解析；
#     若再预置 nameserver=127.0.0.1:53 会与 dnsmasq 的 server=127.0.0.1#7874 形成解析环路。
#   - china_ip_route=2：启用大陆路由白名单（fw4），配套构建时预置的 china_ip_route.ipset。
# 幂等：配置项已存在则不覆盖（uci-defaults 仅首次开机运行，之后自删，不影响用户手动改动）。

uci -q get openclash.config.enable_custom_dns >/dev/null 2>&1 && exit 0

uci -q batch <<-EOF >/dev/null
	set openclash.config.enable_custom_dns='1'
	set openclash.config.china_ip_route='2'
	commit openclash
EOF

exit 0
