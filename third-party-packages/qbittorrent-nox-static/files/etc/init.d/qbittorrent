#!/bin/sh /etc/rc.common

# qbittorrent-nox (static) procd init script.
# WebUI 默认监听 0.0.0.0:8080（admin/adminadmin），可用 uci 覆盖 port / home。

START=99
STOP=10
USE_PROCD=1

qbittorrent_nox=/usr/bin/qbittorrent-nox

start_service() {
    [ -x "$qbittorrent_nox" ] || return 1

    local port home
    config_load qbittorrent
    config_get port qbittorrent port 8080
    config_get home qbittorrent home /etc/qbittorrent

    mkdir -p "$home"

    procd_open_instance
    procd_set_param command "$qbittorrent_nox"
    procd_append_param command --webui-port="$port"
    procd_append_param command --profile="$home"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
